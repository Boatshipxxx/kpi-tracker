{
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "boatship.jp"
        }
      ],
      "destination": "https://www.boatship.jp/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/materials/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
