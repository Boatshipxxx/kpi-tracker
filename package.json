{
  "name": "boatship-site",
  "private": true,
  "description": "BOATship corporate site. 静的HTML + Vercel Functions (/api)。依存はリード獲得導線のサーバー処理でのみ使用する。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:articles": "node scripts/build-articles.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
