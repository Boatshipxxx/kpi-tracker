    "test:leads": "node --test \"tests/**/*.test.js\"",
    "build:material-pdf": "node scripts/build-material-pdf.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/functions": "^2.0.0",
    "resend": "^4.0.1"
  }
}
